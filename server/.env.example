# Eigent — variables del executor Pocket-to-Office (server/)
#
# Copy to server/.env and fill in. Read at boot by uvicorn (program
# [backend] de supervisord). Documentación: PARTE 15 del reporte de
# verificación y SQL-NUMERIC-01.
#
# ── Executor office ─────────────────────────────────────────────────
# Pasarela local que usa el executor para contestar /office/task.
# Mismo contrato que NP_OFFICE_TASK_URL del listener (mismo ecosistema
# que RAG y Odysseus).
NP_OFFICE_LLM_URL=http://127.0.0.1:14000
NP_OFFICE_LLM_MODEL=sovereign-assistant
NP_OFFICE_LLM_KEY=sk-...                       # master key de LiteLLM

# (Opcional) A dónde reenviar la tarea en vez de responder con el LLM:
# el Brain de escritorio u otro worker. Si está, manda esta URL.
#NP_OFFICE_EIGENT_EXECUTOR_URL=http://127.0.0.1:5001/office/task

# (Opcional) Directorio de los CSV de RAG-DATA que carga
# office_grounding.py para calcular los agregados con SQL.
# Si no se define, se prueba <repo>/data/uploads y después
# /persistent/projects/local-rag-multiagents-project/data/uploads.
#NP_OFFICE_CSV_DIR=/persistent/projects/local-rag-multiagents-project/data/uploads
